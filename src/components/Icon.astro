  whistle: '<circle pathLength="100" cx="9" cy="14" r="5.5"/><path pathLength="100" d="M13 10h8v3.5l-6.6 1.7"/><path pathLength="100" d="M9 5.5V3M5.5 6.5 4 4.7M12.5 6.5 14 4.7"/>',
