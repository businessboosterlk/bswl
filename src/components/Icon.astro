---
// One icon component. The shapes come from src/data/icons.json, which scripts/build-icons.mjs writes from two licensed
// sets: Lucide for line icons, Simple Icons for the brand marks (WhatsApp, Instagram, Facebook, YouTube). Never type
// path data here. To add an icon, add its name to build-icons.mjs and run it.
import icons from '../data/icons.json';
const { name } = Astro.props;
const brand = icons.brand[name];
const body = brand || icons.line[name];
if (!body) throw new Error(`Icon "${name}" is not in icons.json. Add it to scripts/build-icons.mjs, never draw it.`);
---
{brand
  ? <svg class="ic ic-brand" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={body} />
  : <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={body} />}
